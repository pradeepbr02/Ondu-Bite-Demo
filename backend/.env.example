NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ecom?replicaSet=rs0
CORS_ORIGIN=http://localhost:3000
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0

# Optional. Free-text support chat uses Google Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Cloud image storage. AWS credentials stay in the backend environment/profile.
AWS_REGION=us-east-1
S3_BUCKET=ecom-ondu-bite
S3_PREFIX=ondu-bite/
# Optional stable CDN backed by the same private bucket, with no origin path:
# MEDIA_PUBLIC_BASE_URL=https://images.example.com
