{
  "name": "ecom-api",
  "version": "1.0.0",
  "description": "Ecommerce API learning project",
  "scripts": {
    "catalog:mixes": "tsx src/scripts/refresh-mixes.ts",
    "images:packages": "tsx src/scripts/refresh-package-photos.ts",
    "stock:preview": "tsx src/scripts/stock-preview.ts",
    "catalog:refresh": "tsx src/scripts/import-pantry.ts",
    "admin:role": "tsx src/scripts/admin-role.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts",
    "db:indexes": "tsx src/scripts/indexes.ts",
    "db:check": "tsx src/scripts/check-db.ts",
    "worker:inventory": "tsx src/worker.ts",
    "images:upload": "tsx src/scripts/upload-images.ts",
    "images:check": "tsx src/scripts/check-images.ts",
    "images:upload-one": "tsx src/scripts/upload-image.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": ".cache/mongodb-binaries",
      "version": "8.0.17"
    }
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
